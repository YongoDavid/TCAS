# Copy to .env and fill values. Do NOT commit .env to git.

# Admin API key used to protect admin API endpoints (GET /api/inquiry)
ADMIN_API_KEY=your-strong-random-api-key

# Prisma / Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# MongoDB (if using MongoDB/Mongoose)
MONGODB_URI=mongodb+srv://davidyongo9_db_user:DctZBqcLeWAmaNGa@cluster0.19npzqv.mongodb.net/

# (Optional) SMTP settings for sending emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=super-secret
ADMIN_EMAIL=admin@example.com

# Google reCAPTCHA v3 (server secret)
RECAPTCHA_SECRET=your-recaptcha-secret
# Minimum score to accept (v3). Defaults to 0.5
RECAPTCHA_MIN_SCORE=0.5

# Redis for rate limiting (e.g., upstash redis)
REDIS_URL=redis://:password@hostname:port
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=20

# SendGrid settings
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM=verified-sender@example.com

